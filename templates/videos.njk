---
layout: layouts/base.njk
title: Videos
description: Miles Caton music videos, live performances and TV appearances. They play right here.
pageKey: videos
next: { label: "photos", url: "/photos/" }
---
{% set heading = "videos" %}{% set subL = videos.sub_left %}{% set subR = (videos.items.length + " videos") %}{% include "partials/pagehead.njk" %}
<div class="vwall">
  {% for v in videos.items %}
  <figure class="vt fade{% if v.wide %} wide{% endif %}">
    <div class="vt-scr">
      {% if v.youtube or v.playlist %}
      <iframe loading="lazy" src="https://www.youtube-nocookie.com/embed/{% if v.youtube %}{{ v.youtube }}?{% else %}videoseries?list={{ v.playlist }}&amp;{% endif %}rel=0&amp;playsinline=1&amp;modestbranding=1" title="{{ v.title }} on YouTube" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
      {% else %}
      <div class="vt-snow" aria-hidden="true"></div>
      {% if v.link %}<a class="vt-out" href="{{ v.link }}" data-cur="open">{{ v.link_label }}</a>{% else %}<span class="vt-out off">Not online yet</span>{% endif %}
      {% endif %}
    </div>
    <figcaption>
      <span class="kind">{{ v.kind }}</span>
      <h2>{{ v.title }}</h2>
      <p class="meta">{{ v.meta | mdi | safe }}</p>
      {% if v.youtube %}<a class="lk yt-link" href="https://www.youtube.com/watch?v={{ v.youtube }}">Open on YouTube</a>{% elif v.playlist %}<a class="lk yt-link" href="https://www.youtube.com/playlist?list={{ v.playlist }}">Open on YouTube</a>{% endif %}
    </figcaption>
  </figure>
  {% endfor %}
</div>

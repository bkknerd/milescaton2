---
layout: layouts/base.njk
title: Story
description: Miles Caton's career year by year, from singing in church in Brooklyn to Sinners and Columbia Records.
pageKey: story
next: { label: "sinners", url: "/sinners/" }
---
{% set heading = "story" %}{% set subL = story.sub_left %}{% set subR = story.sub_right %}{% include "partials/pagehead.njk" %}
{% if story.intro %}<div class="story-intro grid"><p>{{ story.intro | mdi | safe }}</p></div>{% endif %}
<ol class="tl">
  {% for it in story.items %}<li><span class="when"><b data-chalk="circle" data-direct>{{ it.year }}</b>{% if it.year != "Now" %}<span>{{ it.when }}</span>{% endif %}</span><div><h2>{{ it.title | mdi | safe }}</h2><p>{{ it.text | mdi | safe }}</p></div></li>{% endfor %}
</ol>

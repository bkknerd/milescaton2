---
layout: layouts/base.njk
title: Story
description: Miles Caton's career year by year, from singing in church in Brooklyn to Sinners and Columbia Records.
pageKey: story
next: { label: "sinners", url: "/sinners/" }
---
{% set heading = "story" %}{% set subL = story.sub_left %}{% set subR = story.sub_right %}{% include "partials/pagehead.njk" %}
<div class="story">
  <div class="yr" aria-hidden="true"><b id="yrNum">{{ story.start_year }}</b><span class="age" id="yrAge">{{ story.start_note }}</span></div>
  <ol>
    {% for it in story.items %}<li data-y="{{ it.year }}" data-a="{{ it.when }}"><span class="when">{{ it.when if it.year == "Now" else (it.year + " · " + it.when) }}</span><h2>{{ it.title | mdi | safe }}</h2><p>{{ it.text | mdi | safe }}</p></li>{% endfor %}
  </ol>
</div>

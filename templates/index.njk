---
layout: layouts/base.njk
pageKey: home
---
{%- set h = home.hero %}
<div class="board-hero">
  <h1 class="sig-write"{% if site.logo %} style="--sig:url('{{ site.logo }}')"{% endif %}><span class="vh">{{ site.name }}</span><svg class="sig-svg" viewBox="0 0 500 745" aria-hidden="true" focusable="false"><defs><mask id="sigm" maskUnits="userSpaceOnUse" x="0" y="0" width="500" height="745"><path class="st" pathLength="1" d="M27.5 63.3 L37.5 178.8 L45 286.8" stroke-width="40" style="--d:0.20s;--t:0.11s"/><path class="st" pathLength="1" d="M32.5 82.0 L70 145.3 L80 3.7 L110 163.9 L175 342.7" stroke-width="44" style="--d:0.32s;--t:0.28s"/><path class="st" pathLength="1" d="M147.5 93.1 L162.5 156.5" stroke-width="26" style="--d:0.61s;--t:0.07s"/><path class="st" pathLength="1" d="M165 160.2 L205 283.1" stroke-width="26" style="--d:0.69s;--t:0.07s"/><path class="st" pathLength="1" d="M152.5 11.2 L195 149.0 L237.5 294.3" stroke-width="20" style="--d:0.77s;--t:0.14s"/><path class="st" pathLength="1" d="M242.5 178.8 L265 152.7 L262.5 122.9 L247.5 149.0 L237.5 201.2 L262.5 219.8 L290 193.7 L320 134.1" stroke-width="34" style="--d:0.93s;--t:0.14s"/><path class="st" pathLength="1" d="M380 96.9 L355 78.2 L337.5 104.3 L345 141.6 L385 156.5 L387.5 178.8 L357.5 190.0" stroke-width="34" style="--d:1.08s;--t:0.10s"/><path class="st" pathLength="1" d="M175 379.9 L125 383.7 L60 447.0 L22.5 558.8 L12.5 655.6 L30 715.2 L70 722.6 L125 670.5 L190 588.6 L240 517.8" stroke-width="78" style="--d:1.19s;--t:0.35s"/><path class="st" pathLength="1" d="M267.5 547.6 L275 439.6 L320 521.5" stroke-width="34" style="--d:1.55s;--t:0.10s"/><path class="st" pathLength="1" d="M260 368.8 L320 312.9 L385 257.0" stroke-width="34" style="--d:1.66s;--t:0.08s"/><path class="st" pathLength="1" d="M322.5 320.4 L335 409.8 L347.5 502.9" stroke-width="30" style="--d:1.75s;--t:0.09s"/><path class="st" pathLength="1" d="M395 361.3 L377.5 402.3 L382.5 454.4 L402.5 465.6 L420 417.2 L415 368.8 L387.5 357.6" stroke-width="34" style="--d:1.86s;--t:0.12s"/><path class="st" pathLength="1" d="M452.5 432.1 L442.5 346.4 L490 402.3 L480 253.3" stroke-width="32" style="--d:1.99s;--t:0.15s"/></mask></defs><image href="{{ site.logo }}" width="500" height="745" mask="url(#sigm)"/></svg><span class="chalk-start" data-chalk="start"></span></h1>
  <p class="corner tl hand">{{ h.tl }}</p>
  <p class="corner bl hand">{{ h.bl }}</p>
</div>

{%- set r = home.release %}
<section class="release grid" aria-labelledby="rel">
  <p class="kick">{{ r.kicker }}</p>
  <h2 class="rel chalked" id="rel" data-chalk="under2">{{ r.title }}</h2>
  <dl class="fade">{% for f in r.facts %}<dt>{{ f.label }}</dt><dd>{{ f.value | mdi | safe }}</dd>{% endfor %}</dl>
  <div class="acts fade">
    {% if r.youtube %}<a class="lk" href="https://www.youtube.com/watch?v={{ r.youtube }}" data-yt="{{ r.youtube }}" data-title="{{ r.title | title }}" data-cur="play">Play the video</a>{% endif %}
    {% if r.announce_url %}<a class="lk" href="{{ r.announce_url }}">{{ r.announce_label }}</a>{% endif %}
  </div>
</section>

<section class="hub" aria-label="Listen and follow">
  <div class="hub-col">
    <h2 class="hub-h" data-chalk="circle">listen</h2>
    {% for l in site.listen %}<a class="hub-a" href="{{ l.url }}" data-cur="listen"><b>{{ l.label }}</b><span>{{ l.note }}</span></a>{% endfor %}
  </div>
  <div class="hub-col">
    <h2 class="hub-h">follow</h2>
    {% for l in site.follow %}<a class="hub-a" href="{{ l.url }}" data-cur="follow"><b>{{ l.label }}</b><span>{{ l.note }}</span></a>{% endfor %}
  </div>
</section>

{%- set b = home.bio %}
<section class="strip-ph" aria-labelledby="stripH">
  <div class="strip-head"><h2 class="hub-h" id="stripH">{{ home.strip.label }}</h2><a class="lk" href="/photos/">{{ home.strip.link_label }}</a></div>
  <div class="strip-row">
    {% for p in home.strip.photos %}<a href="/photos/" data-chalk="frame">{% img p.src, p.alt, "", "(max-width: 900px) 60vw, 22vw" %}</a>{% endfor %}
  </div>
</section>

<section class="bio grid" aria-label="About Miles">
  <p class="rv">{{ b.text }}</p>
  <a class="more" href="/story/">His story, year by year</a>
  {% if b.photo %}<figure class="bio-ph" data-chalk="frame" data-gutter="r">{% img b.photo, b.photo_alt, "", "(max-width: 900px) 90vw, 30vw" %}</figure>{% endif %}
</section>

{%- set n = home.noise %}
<section class="con grid" aria-labelledby="conH">
  <h2 class="con-h chalked" id="conH" data-chalk="circle" data-gutter="r">{{ n.heading }}</h2>
  <p class="con-t fade">{{ n.text | mdi | safe }}</p>
  <a class="con-l lk fade" href="{{ n.link_url }}">{{ n.link_label }}</a>
</section>

<nav aria-label="On this site">
  <ul class="index">
    {% for i in home.index %}<li><a href="{{ i.url }}" data-cur="open"><span class="nm">{{ i.label }}</span><span class="ds">{{ i.text | mdi | safe }}</span></a></li>{% endfor %}
  </ul>
</nav>

<section class="sign-off" aria-label="Sign-off">
  <div class="big fade" role="img" aria-label="{{ site.name }} signature"{% if site.logo %} style="--sig:url('{{ site.logo }}')"{% endif %}></div>
  <div class="txt">
    <p class="rv">{{ home.signoff.text }}</p>
    <div class="links fade">{% for l in home.signoff.links %}<a class="lk" href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</div>
    <span class="chalk-end" data-chalk="end" data-gutter="r" aria-hidden="true"></span>
  </div>
</section>
